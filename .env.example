# Pet IoT Sensors Service Configuration

# Service
PORT=3005

# MQTT Broker
MQTT_HOST=localhost
MQTT_PORT=1883
# MQTT_USERNAME=your_username
# MQTT_PASSWORD=your_password

# Backend URLs - Auto-selects local or cloud
LOCAL_BACKEND_URL=http://localhost:3000
CLOUD_BACKEND_URL=https://api.petsmart.example.com
API_KEY=smart-pet-api-key-2026

# Offline Queue
OFFLINE_QUEUE_FILE=./data/offline-queue.json

# Alert Thresholds
TEMP_HIGH=30
TEMP_LOW=10
