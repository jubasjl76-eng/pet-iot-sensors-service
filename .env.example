# Pet IoT Sensors Service — mirrors src/config/index.ts (Phase 12 config contract).
# `cp .env.example .env` is a working local start. A missing/invalid var → boot
# prints the problem + exits. Grouped: public · runtime non-secret · SECRET.

# ── public / build-time ────────────────────────────────────────────────
PORT=3005

# ── runtime non-secret ─────────────────────────────────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883
# MQTT_USERNAME=

# Sensor telemetry is forwarded to the backend API (no DB of its own).
LOCAL_BACKEND_URL=http://localhost:3000
# CLOUD_BACKEND_URL=https://api.smartpet.example/api
OFFLINE_QUEUE_FILE=./data/offline-queue.json

# Alert thresholds
TEMP_HIGH=30
TEMP_LOW=10
HUMIDITY_HIGH=80
HUMIDITY_LOW=25
AIR_QUALITY_HIGH=1200
ALERT_DEDUPE_MINUTES=15

# ── SECRET (AWS Secrets Manager in cloud; SOPS+age for git non-prod) ────
# MQTT_PASSWORD=
API_KEY=smart-pet-api-key-2026

# ── Error tracking (Phase 15) ──────────────────────────────────────────────
# Unset → Sentry is a no-op. DSN is not a secret.
# SENTRY_DSN=https://xxxx@oNNN.ingest.sentry.io/NNN
# SENTRY_ENVIRONMENT=              # defaults to NODE_ENV
# SENTRY_RELEASE=                  # defaults to pet-iot-sensors-service@<version>
# SENTRY_TRACES_SAMPLE_RATE=0      # perf tracing; stays 0 until Phase 16

# Observability (Phase 16). /metrics is open unless this is set.
# METRICS_TOKEN=change-me

# LOG_LEVEL=info
