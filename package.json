{
  "name": "pet-iot-sensors-service",
  "version": "1.0.0",
  "description": "IoT sensor data service for kennels and pet owners",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "docker:build": "docker build -t pet-iot-sensors-service .",
    "docker:run": "docker run -d -p 3005:3005 pet-iot-sensors-service"
  },
  "dependencies": {
    "@jubasjl76-eng/shared": "git+https://github.com/jubasjl76-eng/smart-pet-shared.git#shared-v0.1.0",
    "@sentry/node": "^10.74.0",
    "axios": "^1.7.9",
    "dotenv": "^16.4.0",
    "express": "^4.21.2",
    "mqtt": "^5.10.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.43.0"
  }
}
